`timescale 1ns / 1ps

module tb_booth ();

reg signed [7:0] X, Y;
wire signed [15:0] P;

booth uut (
.multiplicand(X),
.multiplier(Y),
.product(P)
);

initial begin
$monitor ("T=%0t, multiplicand=%0d, multiplier=%0d, Prod=%0d ", $time, $signed(X),
  $signed(Y),  $signed(P));
 X=0; Y=0;
#20;
X = 8'd25; Y = 8'd15; #20;
X = -8'd30; Y = -8'd30; #20;  
X = -8'd25; Y = 8'd30; #20;
X = 8'd30; Y = -8'd15; #20;
X = 8'd100; Y = 8'd3; #20;

$finish;
end

endmodule
